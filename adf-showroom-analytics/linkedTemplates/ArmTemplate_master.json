{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-showroom-analytics"
		},
		"LS_ADLS_Showroom_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Showroom'"
		},
		"LS_AzureSQL_Control_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_Control'"
		},
		"LS_MSSQL_Showroom_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_MSSQL_Showroom'"
		},
		"LS_PostgreSQL_Showroom_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_PostgreSQL_Showroom'"
		},
		"LS_ADLS_Showroom_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stshowroomanalytics01.dfs.core.windows.net/"
		},
		"LS_AzureSQL_Control_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-showroom-control.database.windows.net"
		},
		"LS_AzureSQL_Control_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ShowroomControlDB"
		},
		"LS_AzureSQL_Control_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Sachin"
		},
		"LS_MSSQL_Showroom_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_MSSQL_Showroom_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Car_Showroom_Enterprise"
		},
		"LS_MSSQL_Showroom_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ADF_Showroom_User"
		},
		"LS_PostgreSQL_Showroom_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_PostgreSQL_Showroom_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "car_showroom_master"
		},
		"LS_PostgreSQL_Showroom_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgres"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-showroom-analytics_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Showroom_accountKey": {
						"value": "[parameters('LS_ADLS_Showroom_accountKey')]"
					},
					"LS_AzureSQL_Control_password": {
						"value": "[parameters('LS_AzureSQL_Control_password')]"
					},
					"LS_MSSQL_Showroom_password": {
						"value": "[parameters('LS_MSSQL_Showroom_password')]"
					},
					"LS_PostgreSQL_Showroom_password": {
						"value": "[parameters('LS_PostgreSQL_Showroom_password')]"
					},
					"LS_ADLS_Showroom_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Showroom_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_Control_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_Control_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_Control_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_Control_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_Control_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_Control_properties_typeProperties_userName')]"
					},
					"LS_MSSQL_Showroom_properties_typeProperties_server": {
						"value": "[parameters('LS_MSSQL_Showroom_properties_typeProperties_server')]"
					},
					"LS_MSSQL_Showroom_properties_typeProperties_database": {
						"value": "[parameters('LS_MSSQL_Showroom_properties_typeProperties_database')]"
					},
					"LS_MSSQL_Showroom_properties_typeProperties_userName": {
						"value": "[parameters('LS_MSSQL_Showroom_properties_typeProperties_userName')]"
					},
					"LS_PostgreSQL_Showroom_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSQL_Showroom_properties_typeProperties_server')]"
					},
					"LS_PostgreSQL_Showroom_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSQL_Showroom_properties_typeProperties_database')]"
					},
					"LS_PostgreSQL_Showroom_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSQL_Showroom_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}