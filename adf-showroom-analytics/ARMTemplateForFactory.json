{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-showroom-analytics"
		},
		"LS_ADLS_Showroom_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Showroom'"
		},
		"LS_AzureSQL_Control_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_Control'"
		},
		"LS_MSSQL_Showroom_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_MSSQL_Showroom'"
		},
		"LS_PostgreSQL_Showroom_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_PostgreSQL_Showroom'"
		},
		"LS_ADLS_Showroom_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stshowroomanalytics01.dfs.core.windows.net/"
		},
		"LS_AzureSQL_Control_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-showroom-control.database.windows.net"
		},
		"LS_AzureSQL_Control_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ShowroomControlDB"
		},
		"LS_AzureSQL_Control_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Sachin"
		},
		"LS_MSSQL_Showroom_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_MSSQL_Showroom_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Car_Showroom_Enterprise"
		},
		"LS_MSSQL_Showroom_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ADF_Showroom_User"
		},
		"LS_PostgreSQL_Showroom_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_PostgreSQL_Showroom_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "car_showroom_master"
		},
		"LS_PostgreSQL_Showroom_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgres"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_Master_Ingestion')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LKP_Control_Metadata",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT\n    control_id,\n    source_system,\n    table_name,\n    watermark_column,\n    last_load_value,\n    target_container,\n    target_path,\n    is_active\nFROM dbo.data_factory_control_log\nWHERE is_active = 1\nORDER BY control_id;",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AzureSQL_Control",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_AzureSQL_Control')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_Bronze')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_Showroom",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"tableName": {
						"type": "string"
					},
					"loadDate": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().loadDate",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().tableName",
							"type": "Expression"
						},
						"fileSystem": "bronze"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_Showroom')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_AzureSQL_Control')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Control",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "control_id",
						"type": "int",
						"precision": 10
					},
					{
						"name": "source_system",
						"type": "varchar"
					},
					{
						"name": "table_name",
						"type": "varchar"
					},
					{
						"name": "watermark_column",
						"type": "varchar"
					},
					{
						"name": "last_load_value",
						"type": "datetime2",
						"scale": 7
					},
					{
						"name": "target_container",
						"type": "varchar"
					},
					{
						"name": "target_path",
						"type": "varchar"
					},
					{
						"name": "is_active",
						"type": "bit"
					},
					{
						"name": "created_date",
						"type": "datetime2",
						"scale": 7
					},
					{
						"name": "updated_date",
						"type": "datetime2",
						"scale": 7
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "data_factory_control_log"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL_Control')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_MSSQL_Source')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_MSSQL_Showroom",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"tableName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "SqlServerTable",
				"schema": [],
				"typeProperties": {
					"schema": "dbo",
					"table": {
						"value": "@dataset().tableName",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_MSSQL_Showroom')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_PostgreSQL_Source')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_PostgreSQL_Showroom",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"tablename": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": [],
				"typeProperties": {
					"schema": "public",
					"table": {
						"value": "@dataset().tablename",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_PostgreSQL_Showroom')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_ADLS_Showroom')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_ADLS_Showroom_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('LS_ADLS_Showroom_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_AzureSQL_Control')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_AzureSQL_Control_properties_typeProperties_server')]",
					"database": "[parameters('LS_AzureSQL_Control_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_AzureSQL_Control_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_AzureSQL_Control_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_MSSQL_Showroom')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "SqlServer",
				"typeProperties": {
					"server": "[parameters('LS_MSSQL_Showroom_properties_typeProperties_server')]",
					"database": "[parameters('LS_MSSQL_Showroom_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_MSSQL_Showroom_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_MSSQL_Showroom_password')]"
					},
					"alwaysEncryptedSettings": {
						"alwaysEncryptedAkvAuthType": "ManagedIdentity"
					}
				},
				"connectVia": {
					"referenceName": "SHIR-Showroom-Local",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/SHIR-Showroom-Local')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_PostgreSQL_Showroom')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "PostgreSqlV2",
				"typeProperties": {
					"server": "[parameters('LS_PostgreSQL_Showroom_properties_typeProperties_server')]",
					"port": 5432,
					"database": "[parameters('LS_PostgreSQL_Showroom_properties_typeProperties_database')]",
					"username": "[parameters('LS_PostgreSQL_Showroom_properties_typeProperties_username')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_PostgreSQL_Showroom_password')]"
					},
					"sslMode": 2,
					"authenticationType": "Basic"
				},
				"connectVia": {
					"referenceName": "SHIR-Showroom-Local",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/SHIR-Showroom-Local')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SHIR-Showroom-Local')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		}
	]
}